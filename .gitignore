# ==========================================
# Mosladar (মশলাদার) — Git Ignore Configuration
# ==========================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets (CRITICAL: Never commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
*.pem
*.key

# Preserve template file
!.env.example

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# SQLite Database Runtime Locks & WAL Files
# (Do not commit ephemeral lock and journal files)
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Optional: If you use persistent cloud storage/database in production,
# uncomment the line below to prevent local test orders from being pushed to GitHub:
# data/mosladar.db

# IDE & Editor Directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.fleet/

# Temporary / Scratch files
scratch/
.tempmediaStorage/
tmp/
temp/
data/mosladar.db
